# Copy file ini jadi `.env` lalu sesuaikan kalau perlu. Semua sudah punya
# default yang jalan out-of-the-box untuk setup lokal Windows + Docker Desktop.

# --- Ingestion ---
MIN_CONTENT_LENGTH=150
MAX_ARTICLES_PER_TOPIC=8
# Filter by date range: hanya scrape artikel yang terbit dalam N hari terakhir.
# Entry tanpa published_parsed (tanggal tidak diketahui) tetap diproses (tidak di-skip).
MAX_ARTICLE_AGE_DAYS=30
REQUEST_DELAY_MIN_SECONDS=1.0
REQUEST_DELAY_MAX_SECONDS=3.5

# --- Vectorization ---
DENSE_MODEL_NAME=BAAI/bge-large-en-v1.5
SPARSE_MODEL_NAME=Qdrant/bm25
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Qdrant (published port dari docker-compose, diakses dari host) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=fed_news

# --- Vectorization bridge service ---
# Host:port tempat `uvicorn vectorization.service:app` listen (native di host).
VECTOR_SERVICE_HOST=0.0.0.0
VECTOR_SERVICE_PORT=8600
# URL yang dipanggil DARI DALAM container Airflow untuk mencapai service di atas.
# host.docker.internal sudah otomatis tersedia di Docker Desktop (Windows/Mac).
VECTOR_SERVICE_URL=http://host.docker.internal:8600

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
LLM_TOP_K=6

# --- Airflow (dipakai docker-compose, opsional di Windows) ---
AIRFLOW_UID=50000
